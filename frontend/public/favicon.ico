<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <!-- Background -->
  <rect width="64" height="64" rx="12" fill="#1F3327"/>

  <!-- Chains (angled lines from top center down to basket) -->
  <g stroke="#D9A404" stroke-width="1.4" opacity="0.85">
    <line x1="32" y1="10" x2="22" y2="34"/>
    <line x1="32" y1="10" x2="26" y2="34"/>
    <line x1="32" y1="10" x2="30" y2="34"/>
    <line x1="32" y1="10" x2="34" y2="34"/>
    <line x1="32" y1="10" x2="38" y2="34"/>
    <line x1="32" y1="10" x2="42" y2="34"/>
  </g>

  <!-- Top pole cap -->
  <circle cx="32" cy="10" r="3" fill="#D9A404"/>

  <!-- Pole -->
  <rect x="30.5" y="10" width="3" height="44" rx="1.5" fill="#C9CDC4" opacity="0.7"/>

  <!-- Basket top rim -->
  <ellipse cx="32" cy="34" rx="14" ry="3.5" fill="none" stroke="#EFE9DA" stroke-width="2.2"/>

  <!-- Basket body (trapezoid) -->
  <path d="M18 34 L20 48 L44 48 L46 34" fill="none" stroke="#EFE9DA" stroke-width="2" stroke-linejoin="round"/>

  <!-- Basket bottom rim -->
  <ellipse cx="32" cy="48" rx="12" ry="2.8" fill="none" stroke="#EFE9DA" stroke-width="2"/>

  <!-- Basket horizontal band -->
  <path d="M18.8 41 Q32 44 45.2 41" fill="none" stroke="#C9CDC4" stroke-width="1.2" opacity="0.6"/>
</svg>
